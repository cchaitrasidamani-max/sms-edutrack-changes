# ============================================================
# SMS Production .env
# ============================================================
# Upload this file to Jenkins:
#   Manage Jenkins → Credentials → Global → Add Credential
#   Kind : Secret file
#   ID   : sms-env-file
#   File : this file (with real values filled in)
#
# Jenkins scp's it to /opt/sms/.env on EC2-B before every deploy.
# deploy.sh reads it and writes /etc/sms/application.properties.
# ============================================================

# MySQL — must match db_user / db_password in terraform.tfvars
MYSQL_USER=smsuser
MYSQL_PASSWORD=change_this_db_password

# JWT — must be at least 32 characters
JWT_SECRET=replace_with_a_long_random_string_minimum_32_characters

# CORS — comma-separated list of allowed frontend origins
# Use your EC2-B public IP or domain
CORS_ORIGINS=http://YOUR_EC2_B_IP

# Grafana admin password (set after first login)
GRAFANA_PASSWORD=change_this_grafana_password
